# Names only. Never commit values.
#
# Android build (GitHub Actions secrets, or android/local.properties for a local build)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
#
# Supabase deploys (GitHub Actions secrets)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
#
# Edge Function secrets (set with `supabase secrets set`, never in GitHub or the app)
ANTHROPIC_API_KEY=
FDC_API_KEY=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
